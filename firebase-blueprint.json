{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile with preferences and high-level statistics",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique user ID matching request.auth.uid" },
        "email": { "type": "string", "format": "email", "description": "User's email address" },
        "displayName": { "type": "string", "description": "User's full name or screen name" },
        "timezone": { "type": "string", "description": "The user's local timezone identifier" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp when profile was created" },
        "dailyGoalMinutes": { "type": "integer", "description": "User's target productive minutes per day" },
        "focusScore": { "type": "integer", "description": "Overall productivity focus score (0-100)" },
        "completionRate": { "type": "number", "description": "Percentage of tasks completed on time" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Task": {
      "title": "Task",
      "description": "Productivity task with deadline and risk properties",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string", "description": "ID of user who owns the task" },
        "title": { "type": "string", "description": "Title of the task" },
        "description": { "type": "string", "description": "Detailed notes about the task" },
        "dueDate": { "type": "string", "format": "date-time", "description": "Deadline of the task" },
        "estimatedMinutes": { "type": "integer", "description": "Estimated work hours/minutes needed" },
        "actualMinutesSpent": { "type": "integer", "description": "Actual productive time logged" },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "status": { "type": "string", "enum": ["pending", "in_progress", "completed", "overdue"] },
        "riskScore": { "type": "number", "description": "AI predicted risk of missing deadline (0-100)" },
        "riskExplanation": { "type": "string", "description": "AI explanation of why this task is at risk" },
        "recoveryPlan": { "type": "string", "description": "AI-generated step-by-step mitigation plan" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "dueDate", "estimatedMinutes", "priority", "status", "createdAt"]
    },
    "Subtask": {
      "title": "Subtask",
      "description": "Small actionable item broken down from a large goal or task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "taskId": { "type": "string" },
        "userId": { "type": "string", "description": "ID of user who owns this subtask" },
        "title": { "type": "string" },
        "isCompleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["taskId", "userId", "title", "isCompleted", "createdAt"]
    },
    "Goal": {
      "title": "Goal",
      "description": "A high-level target or major milestone",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "targetDate": { "type": "string", "format": "date-time" },
        "progress": { "type": "number", "description": "Completion percentage (0 to 100)" },
        "isCompleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "targetDate", "progress", "isCompleted", "createdAt"]
    },
    "Schedule": {
      "title": "Schedule",
      "description": "Optimized timeline block designed by AI",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string", "description": "The date string in YYYY-MM-DD format" },
        "timeBlocks": {
          "type": "array",
          "description": "List of scheduled events/tasks for the day",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "startTime": { "type": "string" },
              "endTime": { "type": "string" },
              "taskId": { "type": "string" },
              "type": { "type": "string", "enum": ["task", "calendar", "focus", "break"] }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "date", "timeBlocks", "createdAt"]
    },
    "ProductivityLog": {
      "title": "ProductivityLog",
      "description": "Daily metrics and logging to calculate productivity trends",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "focusMinutes": { "type": "integer" },
        "completedTasks": { "type": "integer" },
        "missedDeadlines": { "type": "integer" },
        "score": { "type": "integer", "description": "Daily productivity score (0 to 100)" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "date", "focusMinutes", "completedTasks", "missedDeadlines", "score", "createdAt"]
    },
    "AgentRecommendation": {
      "title": "AgentRecommendation",
      "description": "AI coach intervention advice",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["risk_mitigation", "habit_improvement", "schedule_adjustment"] },
        "message": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "message", "isRead", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "The user profile configuration"
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "The general tasks collection"
    },
    "/subtasks/{subtaskId}": {
      "schema": { "$ref": "#/entities/Subtask" },
      "description": "The subtasks associated with parent tasks"
    },
    "/goals/{goalId}": {
      "schema": { "$ref": "#/entities/Goal" },
      "description": "High level goals and decomposition"
    },
    "/schedules/{scheduleId}": {
      "schema": { "$ref": "#/entities/Schedule" },
      "description": "The optimized calendar timelines generated by AI"
    },
    "/productivity_logs/{logId}": {
      "schema": { "$ref": "#/entities/ProductivityLog" },
      "description": "Productivity scores and activity records"
    },
    "/agent_recommendations/{recommendationId}": {
      "schema": { "$ref": "#/entities/AgentRecommendation" },
      "description": "Recommendations from the AI Coach"
    }
  }
}
